<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medical History Form</title>

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="\assets\css\style.css">
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <!--NAVBAR-->
    <nav class="navbar navbar-expand-lg sticky-top bg-custom">
        <div class="container">
          <a class="navbar-brand" href="views\form.html">
            <img class="logo2" src="\assets\images\logo2.png" alt="">
           </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
              <li class="nav-item">
				<a class="nav-link" href="/home.html">HOME</a>
			</li>
              <li class="nav-item">
                <a class="nav-link" href="/home.html#Login">LOG IN</a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
  
    <div id="form-page" class="container mt-5 hidden">
        <div class="row justify-content-center">
            <div class="col-md-8 form-container">
                <h2 class="text-center">Update</h2>
                <form id="medical-history-form">
                    
                    
                    <!-- Medical Details Section -->
                    <h4 class="mt-4">Medical Details</h4>
					<div class="form-group required">
					<div class="d-flex align-items-end">
						<div style="flex: 1;">
						<label for="patientBType">Blood Type</label>
							<select class="form-control inptborder" id="patientBType" required>
							<option value="" disabled selected>Select</option>
							<option value="O-">O-</option>
							<option value="O+">O+</option>
							<option value="A-">A-</option>
							<option value="A+">A+</option>
							<option value="B-">B-</option>
							<option value="B+">B+</option>
							<option value="AB-">AB-</option>
							<option value="AB+">AB+</option>
						</select>
						</div>
						<div style="flex: 1; margin-left: 10px;">
						<label for="patientHeight">Height (cm)</label>
						<input type="number" class="form-control inptborder" id="patientHeight" required min="0" max="300" step="0.1" title="Please enter a valid height in centimeters (e.g., 175.5)">
						</div>
						<div style="flex: 1; margin-left: 10px;">
						<label for="patientWeight">Weight (kg)</label>
						<input type="number" step="0.01" class="form-control inptborder" id="patientWeight" required  min="0" max="500" step="0.1" title="Please enter a valid weight in kilograms (e.g., 70.5)">
						</div>
					</div>
					</div>
                    <div class="form-group">
                        <label for="doctorPDoc">PCP's Name </label>
                        <input type="text" class="form-control inptborder" id="doctorPDoc" maxlength="40">
                    </div>
					<div class="form-group">
					<div class="d-flex align-items-end">
						<div style="flex: 1;">
						<label for="doctorPNum">PCP's Phone Number </label>
						<input type="tel" class="form-control inptborder" id="doctorPNum" pattern="^\d{10}$" title="Please enter a valid 10-digit phone number. (e.g, 9123456717)">
						</div>
						<div style="flex: 1; margin-left: 10px;">
						<label for="doctorPEmail">PCP's Email Address </label>
						<input type="email" class="form-control inptborder" id="doctorPEmail" placeholder="example@gmail.com">
						</div>
					</div>
					</div>
                    <div id="conditions-container">
                        <h4 class="mt-4">Medical Conditions</h4>
                        <div class="condition-item form-group">
                            <label for="conditionName">Condition Name</label>
                            <input type="text" class="form-control inptborder" name="conditionName[]" maxlength="50">
                            <label for="diagnoseDate">Date of Diagnose</label>
                            <input type="date" class="form-control inptborder" name="diagnoseDate[]">
							<label for="conditionMed">Medicine</label>
                            <input type="text" class="form-control inptborder" name="med[]" maxlength="60">
                            <button type="button" class="btn btn-danger btn-sm delete-condition">Delete</button>
                        </div>
                    </div>
                    <button type="button" id="add-condition" class="btn btn-outline-primary mt-3">Add Another Condition</button>
					
					<!-- Allergy Details Section -->
					<div id="allergy-container">
						<h4 class="mt-4">Allergy Conditions</h4>
						<div class="allergy-item form-group">
							<label for="allergenName">Allergy Name</label>
							<input type="text" class="form-control inptborder" name="allergenName[]" maxlength="30">
							<label for="allergyMed">Medicine</label>
							<input type="text" class="form-control inptborder" name="allergyMed[]" maxlength="30">
							<button type="button" class="btn btn-danger btn-sm delete-allergy">Delete</button>
						</div>
					</div>
					<button type="button" id="add-allergy" class="btn btn-outline-primary mt-3">Add Another Allergy</button>

					<!-- Surgery Details Section -->
					<div id="surgery-container">
					<h4 class="mt-4">Surgery Details</h4>
					<div class="surgery-item form-group">
						<label for="surgeryLoc">Surgery Location</label>
						<input type="text" class="form-control inptborder" name="surgeryLoc[]" maxlength="30">
						<div class="d-flex align-items-end">
							<div style="flex: 1;">
								<label for="surgeryType">Type</label>
								<input type="text" class="form-control inptborder" name="surgeryType[]" maxlength="20">
							</div>
							<div style="flex: 1; margin-left: 10px;">
								<label for="surgeryDate">Date Conducted</label>
								<input type="date" class="form-control inptborder" name="surgeryDate[]">
							</div>
							<button type="button" class="btn btn-danger btn-sm delete-surgery">Delete</button>
						</div>
					</div>
					</div>
					<button type="button" id="add-surgery" class="btn btn-outline-primary mt-3">Add Another Surgery</button>
					<button type="update" id="update-button" class="btn btn-solid btn-block">Update</button>
                    <button  class="btn btn-solid btn-block">Back</button>

				</form>
					<div id="form-result" class="mt-4"></div>
				</div>
			</div>
		</div>

          <!--FOOTER-->
    <section id="footer" class="foot">
        <div class="container">
          <footer class="py-3 my-4">
            <ul class="nav justify-content-center border-bottom pb-3 mb-3"></ul>
            <div  class="footer-logo">
              <img src="\assets\images\logo mini.png" alt="footer-logo">
            </div>
            <p class="text-center">© 2024 INFOMAN BRAGAIS GARCIA PAGUIO SANAO</p>
          </footer>
        </div>
    </section>
	
	<script>
		window.onload = function() {

		  const signUpEmail = localStorage.getItem('signUpEmail');
		  
		  if (signUpEmail) {
			document.getElementById('patientEmail').value = signUpEmail;
		  }
		}
		</script>

