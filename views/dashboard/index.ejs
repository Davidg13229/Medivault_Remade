<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEDIVAULT</title>
    <link rel="stylesheet" href="/assets/css/dbstyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>

    <div class="container">
        <nav>
            <ul>
                <li>
                    <a href="/" class="logo">
                        <img src="assets/images/logo2.png" alt="Logo"> 
                        <span class="nav-item"></span>
                    </a>
                </li>
                <li class="active">
                    <a href="/dashboard"><i class="fas fa-tachometer-alt"></i> 
                        <span class="nav-item">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/dashboard/edit"><i class="fas fa-file-alt"></i> 
                        <span class="nav-item">Edit</span>
                    </a>
                </li>
                <li>
                    <a href="/dashboard/settings"><i class="fas fa-cog"></i>
                        <span class="nav-item">Settings</span>
                    </a>
                </li>
                <li>
                    <a href="/dashboard/logout" class="logout"><i class="fas fa-sign-out-alt"></i>
                        <span class="nav-item">Logout</span>
                    </a>
                </li>
            </ul>
        </nav>

        <section class="main">
            <div class="main-top">
                <% if (data.length > 0) { %>
                    <h1>HELLO, <%= data[0].patientName %>!</h1>
                <% } else { %>
                    <h1>HELLO, Guest!</h1>
                <% } %>
                <!-- <button class="btn btn-brand">
                    <i class="fas fa-pen-square"></i> Edit
                </button> -->
            </div>
            <div class="main-forms">
                <div class="card">
                    <i class="fa-solid fa-id-card-clip"></i>                 
                    <% if (data.length > 0) { %>
                        <h1 class="patientid"><%= data[0].patient_ID %></h1>
                    <% } else { %>
                        <h1 class="patientid">N/A</h1>
                    <% } %>
                    <h2>Patient ID</h2>
                </div>
                <div class="card">
                    <i class="fa-solid fa-stethoscope"></i>                
                    <% if (data.length > 0) { %>
                        <h1><%= data[0].doctorPDoc || 'N/A' %></h1>
                        <h3><%= data[0].doctorPNum || 'N/A' %></h3>
                        <h3><%= data[0].doctorPEmail || 'N/A' %></h3>
                    <% } else { %>
                        <h1>N/A</h1>
                        <h3>N/A</h3>
                        <h3>N/A</h3>
                    <% } %>
                    <h2>PHYSICIAN</h2>
                </div>
                <div class="card">
                    <i class="fa-solid fa-droplet"></i>
                    <% if (data.length > 0) { %>
                        <h1 class="blood"><%= data[0].patientBType || 'N/A' %></h1>
                    <% } else { %>
                        <h1 class="blood">N/A</h1>
                    <% } %>
                    <h2>BLOOD TYPE</h2>
                </div>
                <div class="card">
                    <div class="column">
                        <div class="icons">
                            <i class="fa-solid fa-ruler-vertical"></i>
                            <i class="fa-solid fa-weight-scale"></i>
                        </div>
                        <div class="context">
                            <% if (data.length > 0) { %>
                                <h1 class="hw"><%= data[0].patientHeight ? data[0].patientHeight + ' cm' : 'N/A' %></h1>
                                <h3>Height</h3>
                                <h1 class="hw"><%= data[0].patientWeight ? data[0].patientWeight + ' kg' : 'N/A' %></h1>
                                <h3>Weight</h3>
                            <% } else { %>
                                <h1 class="hw">N/A</h1>
                                <h3>Height</h3>
                                <h1 class="hw">N/A kg</h1>
                                <h3>Weight</h3>
                            <% } %>
                        </div>
                    </div>
                    <h2>MEASUREMENTS</h2>
                </div>
            </div>

            <div class="content-2">
                <section class="conditions">
                    <h1>Medical Conditions</h1>
                    <div class="conditions-box">
                        <div class="conditions-table">
                            <table>
                                <tr>
                                    <th>Condition Name</th>
                                    <th>Diagnosis Date</th>
                                    <th>Medications</th>
                                    
                                </tr>
                                <% if (data.length > 0) { %>
                                    <% data.forEach(row => { %>
                                        <tr>
                                            <td><%= row.conditionName || 'N/A' %></td>
                                            <td><%= row.conditionDiagnosis || 'N/A' %></td>
                                            <td><%= row.conditionMed || 'N/A' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3">No medical conditions found.</td>
                                    </tr>
                                <% } %>
                            </table>
                        </div>
                    </div>
                </section>
                <section class="allergies">
                    <h1>Allergies</h1>
                    <div class="allergies-box">
                        <div class="allergies-table">
                            <table>
                                <tr>
                                    <th>Allergens</th>
                                    <th>Medications</th>
                                </tr>
                                <% if (data.length > 0) { %>
                                    <% data.forEach(row => { %>
                                        <tr>
                                            <td><%= row.allergenName || 'N/A' %></td>
                                            <td><%= row.allergenMed || 'N/A' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="2">No allergies found.</td>
                                    </tr>
                                <% } %>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
                <section class="surgeries">
                    <h1>Surgeries</h1>
                    <div class="surgeries-box">
                        <div class="surgeries-table">
                            <table>
                                <tr>
                                    <th>Location</th>
                                    <th>Surgery Type</th>
                                    <th>Date</th>
                                </tr>
                                <% if (data.length > 0) { %>
                                    <% data.forEach(row => { %>
                                        <tr>
                                            <td><%= row.surgeryLoc || 'N/A' %></td>
                                            <td><%= row.surgeryName || 'N/A' %></td>
                                            <td><%= row.surgeryDate || 'N/A' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3">No surgeries found.</td>
                                    </tr>
                                <% } %>
                            </table>
                        </div>
                    </div>
                </section>
        </section>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="assets/js/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
